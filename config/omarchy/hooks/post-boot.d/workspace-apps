#!/bin/bash
# omarchy:summary=Launch default apps assigned to workspaces

CONF="$HOME/.config/omarchy/workspace-apps.conf"

[[ -f "$CONF" ]] || exit 0

valid_workspace() {
    [[ "${1:-}" =~ ^([1-9]|10)$ ]]
}

launch_and_place() {
    local ws="$1"
    local label="$2"
    local launch_type="$3"
    local target="$4"
    local before after new_addr
    local waited=0
    local -a launch_args

    if ! valid_workspace "$ws"; then
        omarchy-notification-send -u low \
            "Workspace apps: invalid workspace configuration"
        return 0
    fi
    before=$(hyprctl clients -j | jq -r '.[].address' | sort)

    # Launch without evaluating a command string from the config file.
    case "$launch_type" in
        app)
            if [[ "$target" != /* ||
                  "$target" != *.desktop ||
                  ! -f "$target" ]]; then
                omarchy-notification-send -u low \
                    "Workspace apps: invalid desktop entry for $label"
                return 0
            fi

            launch_args=(gio launch "$target")
            uwsm-app -- "${launch_args[@]}" >/dev/null 2>&1 &
            ;;

        web)
            if [[ ! "$target" =~ ^https?://[^[:space:]]+$ ]]; then
                omarchy-notification-send -u low \
                    "Workspace apps: invalid URL for $label"
                return 0
            fi

            launch_args=(omarchy-launch-webapp "$target")
            "${launch_args[@]}" >/dev/null 2>&1 &
            ;;

        *)
            omarchy-notification-send -u low \
                "Workspace apps: unknown launch type for $label"
            return 0
            ;;
    esac


    # Wait up to 10 seconds for a new window.
    while (( waited < 20 )); do
        sleep 0.5
        waited=$((waited + 1))

        after=$(hyprctl clients -j | jq -r '.[].address' | sort)

        new_addr=$(comm -13 \
            <(printf '%s\n' "$before") \
            <(printf '%s\n' "$after") |
            head -n 1)

        [[ -n "$new_addr" ]] && break
    done

    if [[ "$new_addr" =~ ^0x[[:xdigit:]]+$ ]]; then
        hyprctl eval \
            "hl.dispatch(hl.dsp.window.move({ workspace = \"$ws\", window = \"address:$new_addr\", follow = false }))" \
            >/dev/null 2>&1
    else
        omarchy-notification-send -u low \
            "Workspace apps: no window appeared for workspace $ws"
    fi

    sleep 0.1
}

while IFS=$'\t' read -r ws label launch_type target; do
    [[ -n "$ws" ]] || continue
    [[ -n "$label" && -n "$launch_type" && -n "$target" ]] || continue

    launch_and_place "$ws" "$label" "$launch_type" "$target"
done < "$CONF"
