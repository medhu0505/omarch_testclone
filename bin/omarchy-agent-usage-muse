#!/usr/bin/python3
# omarchy:summary=Print the Muse Code usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Muse Code usage into one display-ready JSON record.

Everything the agents panel shows for Muse Code comes from this one command:
live subscription limits from Meta's key endpoint, session and prompt counts
from Muse's local session index, and token totals by day and by model summed
from Muse's own session logs. The panel itself only ever reads the JSON this
prints; it never talks to disk formats or endpoints.

Meta publishes no standalone usage endpoint, but the key mint the CLI itself
uses answers one: POST /muse-code/key with the OAuth login returns the same
key back (idempotent, so a running Muse is never rotated out) plus the live
window and weekly percentages with their reset stamps.

Muse reports a call's cached tokens inside input_tokens, so the per-model
buckets are decomposed — non-cached input, output, cache read, cache write —
and every token is counted exactly once: the four-way sum equals
input + output.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import sqlite3
import tempfile
import urllib.error
import urllib.request
from pathlib import Path

AGENT_ID = "muse"
AGENT_NAME = "Muse Code"
MINT_URL = "https://api.meta.ai/muse-code/key"
WINDOW_MS = 5 * 3600 * 1000
WEEK_MS = 7 * 24 * 3600 * 1000
BUCKET_KEYS = ("inputTokens", "outputTokens", "cacheReadInputTokens", "cacheCreationInputTokens")
CACHE_VERSION = 2


def config_dir() -> Path:
  return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "muse"


def data_dir() -> Path:
  return Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "muse"


def cache_path() -> Path:
  return Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy/agents-muse-cache.json"


def now() -> str:
  return dt.datetime.now(dt.timezone.utc).isoformat()


def zero_bucket() -> dict:
  return {key: 0 for key in BUCKET_KEYS}


def bucket_total(bucket: dict) -> int:
  return sum(int(bucket.get(key) or 0) for key in BUCKET_KEYS)


def merge_bucket(total: dict, bucket: dict) -> None:
  for key in BUCKET_KEYS:
    total[key] += int(bucket.get(key) or 0)


def read_login() -> str:
  try:
    auth = json.loads((config_dir() / "auth.json").read_text())
    return str(auth["providers"]["meta"]["access_token"])
  except (OSError, KeyError, TypeError, json.JSONDecodeError):
    return ""


def fetch_mint(token: str) -> dict:
  request = urllib.request.Request(
    MINT_URL,
    data=b"{}",
    headers={
      "Authorization": "Bearer " + token,
      "Content-Type": "application/json",
      "Accept": "application/json",
      "User-Agent": "muse-code/launcher-3",
    },
    method="POST",
  )
  with urllib.request.urlopen(request, timeout=10) as response:
    return json.load(response)


def parse_mint(payload: dict) -> dict:
  usage = payload.get("subs_usage") if isinstance(payload, dict) else None
  usage = usage if isinstance(usage, dict) else {}
  window = usage.get("window") if isinstance(usage.get("window"), dict) else {}
  weekly = usage.get("weekly") if isinstance(usage.get("weekly"), dict) else {}
  try:
    window_percent = float(window["used_percent"])
    weekly_percent = float(weekly["used_percent"])
    window_reset = int(window["resets_at"])
    weekly_reset = int(weekly["resets_at"])
    minutes = int(window.get("window_duration_mins") or 300)
  except (KeyError, TypeError, ValueError):
    return {"limits": [], "tier": ""}
  label = f"Session ({minutes // 60}-hour)" if minutes >= 60 and minutes % 60 == 0 else f"Session ({minutes}m)"
  return {
    "limits": [
      {
        "label": label,
        "percent": max(0.0, window_percent / 100),
        "resetsAt": dt.datetime.fromtimestamp(window_reset, dt.timezone.utc).isoformat(),
      },
      {
        "label": "Weekly (7-day)",
        "percent": max(0.0, weekly_percent / 100),
        "resetsAt": dt.datetime.fromtimestamp(weekly_reset, dt.timezone.utc).isoformat(),
      },
    ],
    "tier": str(payload.get("subs_tier_name") or ""),
  }


def collect_limits() -> dict:
  token = read_login()
  if not token:
    return {"limits": [], "tier": "", "authHelp": "Run `muse login` to sign in to Muse Code."}
  try:
    return {"limits": [], "tier": "", **parse_mint(fetch_mint(token))}
  except (urllib.error.URLError, json.JSONDecodeError, OSError, ValueError):
    return {
      "limits": [],
      "tier": "",
      "status": "Limits temporarily unavailable",
      "authHelp": "Meta's usage endpoint could not be read; retrying shortly.",
      "retry": True,
    }


def index_stats() -> dict:
  database = data_dir() / "session-index.db"
  stats = {}
  if not database.exists():
    return stats
  days: dict[str, list] = {}
  try:
    connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True, timeout=2)
    try:
      rows = connection.execute("SELECT created_at_us, prompt_count FROM sessions").fetchall()
    finally:
      connection.close()
  except sqlite3.Error:
    return stats
  sessions = prompts = 0
  for created_us, prompt_count in rows:
    try:
      date = dt.datetime.fromtimestamp(float(created_us) / 1_000_000).astimezone().strftime("%Y-%m-%d")
    except (TypeError, ValueError, OSError, OverflowError):
      continue
    count = max(0, int(prompt_count or 0))
    day = days.setdefault(date, [0, 0])
    day[0] += 1
    day[1] += count
    sessions += 1
    prompts += count
  today = days.get(dt.datetime.now().astimezone().strftime("%Y-%m-%d"), [0, 0])
  stats.update(
    totalSessions=sessions,
    totalPrompts=prompts,
    activeDays=len(days),
    activeDates=sorted(days),
    todaySessions=today[0],
    todayPrompts=today[1],
  )
  return stats


def usage_from_event(event: dict) -> tuple[str, dict] | None:
  usage = event.get("usage")
  if not isinstance(usage, dict) or "input_tokens" not in usage:
    return None
  model = str(event.get("model") or AGENT_ID)
  try:
    inputs = max(0, int(usage.get("input_tokens") or 0))
    outputs = max(0, int(usage.get("output_tokens") or 0))
    reads = min(inputs, max(0, int(usage.get("cache_read_tokens") or 0)))
    writes = min(inputs - reads, max(0, int(usage.get("cache_write_tokens") or 0)))
  except (TypeError, ValueError):
    return None
  return model, {
    "inputTokens": inputs - reads - writes,
    "outputTokens": outputs,
    "cacheReadInputTokens": reads,
    "cacheCreationInputTokens": writes,
  }


def parse_session_log(path: Path) -> list[list]:
  events = []
  try:
    with path.open("r", encoding="utf-8", errors="replace") as handle:
      for line in handle:
        if '"usage"' not in line:
          continue
        try:
          record = json.loads(line)
        except json.JSONDecodeError:
          continue
        event = (record.get("payload") or {}).get("event") or {}
        parsed = usage_from_event(event)
        if parsed is None:
          continue
        try:
          stamp_ms = int(float(record.get("recorded_at")) / 1_000)
        except (TypeError, ValueError, OSError, OverflowError):
          continue
        model, bucket = parsed
        events.append([stamp_ms, model, bucket])
  except OSError:
    return []
  return events


def token_events(force: bool, reuse_only: bool) -> list[list]:
  # The session logs run to hundreds of megabytes, so each file's events are
  # cached by (mtime, size) and only new or grown files are re-parsed.
  path = cache_path()
  files = {}
  if not force:
    try:
      cached = json.loads(path.read_text())
      if isinstance(cached, dict) and cached.get("version") == CACHE_VERSION:
        entries = cached.get("files")
        files = dict(entries) if isinstance(entries, dict) else {}
    except (OSError, json.JSONDecodeError):
      pass

  current = dict(files)
  root = data_dir() / "sessions"
  if not reuse_only and root.is_dir():
    for log in sorted(root.rglob("session.jsonl")):
      try:
        info = log.stat()
      except OSError:
        continue
      stamp = f"{int(info.st_mtime_ns)}:{info.st_size}"
      previous = files.get(str(log))
      if isinstance(previous, dict) and previous.get("stamp") == stamp:
        events = previous.get("events") or []
      else:
        events = parse_session_log(log)
      current[str(log)] = {"stamp": stamp, "events": events}

  merged = []
  for entry in current.values():
    merged.extend((entry.get("events") or []) if isinstance(entry, dict) else [])

  if not reuse_only:
    try:
      path.parent.mkdir(parents=True, exist_ok=True)
      descriptor, temporary = tempfile.mkstemp(prefix=".agents-muse-cache.", dir=path.parent)
      with os.fdopen(descriptor, "w") as output:
        json.dump({"version": CACHE_VERSION, "files": current}, output, separators=(",", ":"))
      os.replace(temporary, path)
    except OSError:
      pass
  return merged


def token_stats(events: list[list]) -> dict:
  days: dict[str, dict] = {}
  models: dict[str, dict] = {}
  for stamp_ms, model, bucket in events:
    date = dt.datetime.fromtimestamp(stamp_ms / 1000).astimezone().strftime("%Y-%m-%d")
    merge_bucket(days.setdefault(date, zero_bucket()), bucket)
    merge_bucket(models.setdefault(model, zero_bucket()), bucket)
  recent = []
  current = dt.datetime.now().astimezone()
  for offset in range(6, -1, -1):
    date = (current - dt.timedelta(days=offset)).strftime("%Y-%m-%d")
    recent.append({"date": date, "messageCount": bucket_total(days.get(date) or zero_bucket())})
  return {"modelUsage": models, "recentDays": recent}


def main() -> int:
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true", help="re-parse every session log, ignoring the cache")
  parser.add_argument("--limits-only", action="store_true", help="reuse the cached log scan; only the limits probe must be fresh")
  args = parser.parse_args()

  limits = collect_limits()
  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": now(),
    "ready": False,
    "hasLocalStats": True,
    "tierLabel": limits.get("tier"),
    "usageStatusText": limits.get("status", ""),
    "authHelpText": limits.get("authHelp", ""),
    "limits": limits["limits"],
    **index_stats(),
    **token_stats(token_events(args.force, args.limits_only)),
  }
  record["ready"] = record.get("totalPrompts", 0) > 0 or record.get("totalSessions", 0) > 0 or len(record["limits"]) > 0
  if limits.get("retry"):
    record["retryAdvised"] = True
  print(json.dumps(record, separators=(",", ":"), sort_keys=True))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
