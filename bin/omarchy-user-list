#!/bin/bash

# omarchy:summary=List login users and which are administrators
# omarchy:args=[--json]

set -euo pipefail

json="false"

while (( $# > 0 )); do
  case "$1" in
  --json)
    json="true"
    ;;
  -h | --help)
    echo "Usage: omarchy user list [--json]"
    exit 0
    ;;
  *)
    echo "omarchy-user-list: unknown option: $1" >&2
    exit 1
    ;;
  esac
  shift
done

login_defs=${OMARCHY_LOGIN_DEFS:-/etc/login.defs}

login_def() {
  local value
  value=$(awk -v key="$1" '$1 == key { print $2; exit }' "$login_defs" 2>/dev/null || true)
  if [[ $value =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$value"
  else
    printf '%s\n' "$2"
  fi
}

uid_min=$(login_def UID_MIN 1000)
uid_max=$(login_def UID_MAX 60000)

# Administrators are the members of wheel: the group sudo and polkit trust.
wheel=$(getent group wheel || true)
wheel_gid=$(cut -d: -f3 <<<"$wheel")
wheel_members=",$(cut -d: -f4 <<<"$wheel"),"

# One call each for sessions and last logins, so the cost stays flat however
# many accounts there are.
signed_in=" $(loginctl list-users --no-legend --no-pager 2>/dev/null | awk '{ printf "%s ", $2 }') "
last_logins=$(lastlog2 2>/dev/null | awk 'NR > 1 && NF >= 7 {
  date = $(NF-5); for (i = NF-4; i <= NF; i++) date = date " " $i
  print $1 "\t" date
}' || true)

rows=$(
  getent passwd | while IFS=: read -r name _ uid gid _ _ shell; do
    (( uid >= uid_min && uid <= uid_max )) || continue
    [[ $shell == */nologin || $shell == */false ]] && continue

    admin="false"
    if [[ $wheel_members == *",$name,"* || $gid == "$wheel_gid" ]]; then
      admin="true"
    fi

    online="false"
    [[ $signed_in == *" $name "* ]] && online="true"

    last=$(awk -F '\t' -v user="$name" '$1 == user { print $2; exit }' <<<"$last_logins")
    if [[ -n $last ]]; then
      last=$(date -d "$last" '+%Y-%m-%dT%H:%M:%S%:z' 2>/dev/null || true)
    fi

    printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$uid" "$admin" "$online" "$last"
  done | sort -t $'\t' -k1,1
)

if [[ $json == "true" ]]; then
  jq -R -s '
    split("\n") | map(select(length > 0) | split("\t") | {
      user: .[0],
      uid: (.[1] | tonumber),
      admin: (.[2] == "true"),
      signed_in: (.[3] == "true"),
      last_login: (if .[4] == "" then null else .[4] end)
    })
  ' <<<"$rows"
  exit 0
fi

awk -F '\t' '
  function yesno(value) { return value == "true" ? "yes" : "no" }
  BEGIN { printf "%-24s %-6s %-10s %s\n", "USER", "ADMIN", "SIGNED IN", "LAST LOGIN" }
  NF {
    last = $5 == "" ? "never" : substr($5, 1, 10) " " substr($5, 12, 5)
    printf "%-24s %-6s %-10s %s\n", $1, yesno($3), yesno($4), last
  }
' <<<"$rows"
