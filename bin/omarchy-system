#!/bin/bash

# omarchy:summary=Log out, reboot, or shut down after closing applications
# omarchy:args=<logout|reboot|shutdown>
# omarchy:examples=omarchy system logout | omarchy system reboot | omarchy system shutdown
# omarchy:aliases=omarchy logout | omarchy reboot | omarchy shutdown

usage="Usage: omarchy-system <logout|reboot|shutdown>"
for arg in "$@"; do
  case $arg in
    -h | --help) echo "$usage"; exit 0 ;;
  esac
done
if (( $# > 2 )); then
  echo "$usage" >&2
  exit 2
fi

action=${1:-}
case $action in
  logout) message="$(omarchy-i18n "Logging out")"; command=(uwsm stop) ;;
  reboot) message="$(omarchy-i18n "Rebooting")"; command=(systemctl reboot --no-wall) ;;
  shutdown) message="$(omarchy-i18n "Shutting down")"; command=(systemctl poweroff --no-wall) ;;
  *) echo "$usage" >&2; exit 2 ;;
esac

exit_session() {
  omarchy-osd -i "$action" -m "$message" -d 5000
  if [[ $action != "logout" ]]; then
    omarchy-state clear re*-required
  fi

  # Proceed as soon as apps exit, with a bound for unresponsive windows.
  timeout 2s omarchy-hyprland-window-close-all --wait
  "${command[@]}"
}

if [[ ${2:-} == "--inhibited" ]]; then
  exit_session
elif [[ ${2:-} == "--execute" ]]; then
  if [[ $action == "shutdown" ]]; then
    # Block lid handling explicitly: it ignores high-level sleep inhibitors.
    systemd-inhibit --what=sleep:idle:handle-lid-switch \
      --who=Omarchy --why="Shutdown in progress" --mode=block \
      "$0" "$action" --inhibited
  else
    exit_session
  fi
  status=$?
  if (( status != 0 )); then
    omarchy-notification-send -u critical "$(omarchy-i18n "%1 failed" "$(omarchy-i18n "${action^}")")" "$(omarchy-i18n "Could not complete %1. Please try again." "Could not complete $action. Please try again." "$(omarchy-i18n "${action^}")")"
    exit "$status"
  fi
elif [[ -z ${2:-} ]]; then
  # Survive closing the terminal that requested the session exit.
  locale_env=()
  for variable in OMARCHY_UI_LANGUAGE LANGUAGE LC_ALL LC_MESSAGES LANG; do
    if [[ -v $variable ]]; then
      locale_env+=("--setenv=$variable")
    fi
  done
  systemd-run --user --collect --quiet --property=Type=exec --property=RuntimeMaxSec=30s \
    --setenv=PATH --setenv=HYPRLAND_INSTANCE_SIGNATURE --setenv=OMARCHY_PATH "${locale_env[@]}" \
    "$0" "$action" --execute
else
  echo "$usage" >&2
  exit 2
fi
