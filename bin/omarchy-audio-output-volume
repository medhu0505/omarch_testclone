#!/bin/bash

# omarchy:summary=Adjust output volume and show the Omarchy OSD
# omarchy:args=<raise|lower|mute-toggle|+N|-N>
# omarchy:examples=omarchy audio output volume raise | omarchy audio output volume lower | omarchy audio output volume mute-toggle | omarchy audio output volume +1

set -o pipefail

action="${1:-}"

if [[ -z $action ]]; then
  echo "Usage: omarchy-audio-output-volume <raise|lower|mute-toggle|+N|-N>"
  exit 1
fi

runtime_dir="${XDG_RUNTIME_DIR:-}"
if [[ -z $runtime_dir ]]; then
  runtime_dir="${HOME:?}/.cache/omarchy/audio-output-volume"
  install -d -m700 "$runtime_dir" || exit 1
fi

# Drop overlapping key repeats; keep the volume change and its OSD in order.
exec {lock_fd}>"$runtime_dir/omarchy-audio-output-volume.lock" || exit 1
flock -n "$lock_fd" || exit 0

# Resolve through any DSP sink to the physical one, so the keys always move real
# loudness and the processing always sees full-scale input. Shared with the audio
# panel and the output switcher.
sink="$(omarchy-audio-output-sink)" || exit 1
if [[ -z $sink ]]; then
  echo "Could not resolve an audio sink to control." >&2
  exit 1
fi

# pactl reports the same percentage scale wpctl does (both are the raw volume
# over PA_VOLUME_NORM), so the OSD reads identically either way.
volume_percent() {
  pactl get-sink-volume "$sink" 2>/dev/null |
    awk 'NR == 1 {
      for (i = 1; i <= NF; i++)
        if ($i ~ /%$/) {sub("%", "", $i); print $i; exit}
    }'
}

case "$action" in
  raise) action="+5" ;;
  lower) action="-5" ;;
esac

if [[ $action == "mute-toggle" ]]; then
  debounce_file="$runtime_dir/omarchy-audio-output-volume-mute-toggle.last"
  now=$(date +%s%3N)
  last=0
  [[ -r $debounce_file ]] && read -r last <"$debounce_file" || true
  if ((now - last < 250)); then
    exit 0
  fi
  printf '%s\n' "$now" >"$debounce_file"

  pactl set-sink-mute "$sink" toggle || exit 1
  percent=$(volume_percent) || exit 1
  muted=$(LC_ALL=C pactl get-sink-mute "$sink" 2>/dev/null && printf '.') || exit 1
  muted=${muted%.}
  muted=${muted%$'\n'}
  case "$muted" in
    "Mute: yes") muted="true" ;;
    "Mute: no") muted="false" ;;
    *) echo "Could not read mute state for $sink." >&2; exit 1 ;;
  esac
elif [[ $action =~ ^([+-])([0-9]+)$ ]]; then
  sign="${BASH_REMATCH[1]}"
  step="${BASH_REMATCH[2]}"

  if [[ $sign == "+" ]]; then
    direction=(--increase)
  else
    # Preserve a gradual decrease when another client has boosted above 100%.
    direction=(--allow-boost --decrease)
  fi

  # Keep trailing newlines until validation: one output line, even if a setter
  # callback failed while pamixer still returned success.
  state=$(pamixer --sink "$sink" "${direction[@]}" "$step" --unmute --get-mute --get-volume && printf '.') || exit 1
  state=${state%.}
  state=${state%$'\n'}
  if [[ $state =~ ^(true|false)\ ([0-9]+)$ ]]; then
    muted="${BASH_REMATCH[1]}"
    percent="${BASH_REMATCH[2]}"
  else
    echo "Could not read volume and mute state for $sink." >&2
    exit 1
  fi
else
  echo "Unknown volume action: $action"
  exit 1
fi

if [[ ! $percent =~ ^[0-9]+$ ]]; then
  echo "Could not read volume for $sink." >&2
  exit 1
fi

if [[ $muted == "true" ]] || ((10#$percent == 0)); then
  icon="volume-muted"
else
  icon="volume-high"
fi

omarchy-osd -i "$icon" -p "$percent"
