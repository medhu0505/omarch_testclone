#!/usr/bin/python3
# omarchy:summary=Print the Antigravity usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Google Antigravity usage into one display-ready JSON record.

Parses local sessions and conversation logs from ~/.gemini/antigravity-cli/brain/
(and ~/.gemini/antigravity/brain/ when present)
and prints a JSON record matching the Omarchy agents panel contract.
"""

from __future__ import annotations

import datetime as dt
import json
import os
import sys
from pathlib import Path

AGENT_ID = "agy"
AGENT_NAME = "Antigravity"
AUTH_HELP = "Run `agy` to authenticate."


def prompt_date(entry):
  raw = entry.get("created_at")
  if not isinstance(raw, str):
    return None
  try:
    parsed = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
  except ValueError:
    return None
  if parsed.tzinfo is None:
    parsed = parsed.replace(tzinfo=dt.timezone.utc)
  return parsed.astimezone().date().isoformat()


def main():
  now = dt.datetime.now(dt.timezone.utc)
  today = dt.datetime.now().astimezone().date()
  today_str = today.isoformat()

  recent_dates = [
      (today - dt.timedelta(days=i)).isoformat()
      for i in range(6, -1, -1)
  ]
  daily_prompts = {d: 0 for d in recent_dates}
  active_dates = set()
  today_sessions = set()

  gemini_dir = Path.home() / ".gemini"
  brain_dirs = [d for d in (gemini_dir / "antigravity-cli" / "brain", gemini_dir / "antigravity" / "brain") if d.is_dir()]
  total_prompts = 0
  total_sessions = 0

  for brain_dir in brain_dirs:
    for conv_dir in brain_dir.iterdir():
      if not conv_dir.is_dir():
        continue
      total_sessions += 1
      transcript_file = conv_dir / ".system_generated" / "logs" / "transcript.jsonl"
      if not transcript_file.is_file():
        continue
      try:
        with open(transcript_file, "r", encoding="utf-8", errors="ignore") as f:
          for line in f:
            if "USER_INPUT" not in line:
              continue
            try:
              entry = json.loads(line)
            except ValueError:
              continue
            if not isinstance(entry, dict) or entry.get("type") != "USER_INPUT":
              continue

            total_prompts += 1
            day = prompt_date(entry)
            if day is None:
              continue
            active_dates.add(day)
            if day in daily_prompts:
              daily_prompts[day] += 1
            if day == today_str:
              today_sessions.add(conv_dir)
      except OSError:
        pass

  today_prompts = daily_prompts.get(today_str, 0)
  recent_days = [{"date": d, "messageCount": daily_prompts[d]} for d in recent_dates]
  sorted_active_dates = sorted(list(active_dates))

  record = {
      "schemaVersion": 1,
      "id": AGENT_ID,
      "name": AGENT_NAME,
      "updatedAt": now.isoformat(),
      "ready": bool(brain_dirs),
      "hasLocalStats": True,
      "todayPrompts": today_prompts,
      "todaySessions": len(today_sessions),
      "todayTotalTokens": 0,
      "todayTokensByModel": {},
      "recentDays": recent_days,
      "totalPrompts": total_prompts,
      "totalSessions": total_sessions,
      "activeDays": len(sorted_active_dates),
      "activeDates": sorted_active_dates,
      "modelUsage": {},
      "limits": [],
      "tierLabel": "",
      "usageStatusText": "",
      "authHelpText": "" if brain_dirs else AUTH_HELP,
  }

  print(json.dumps(record, separators=(",", ":")))


if __name__ == "__main__":
  main()
