#!/bin/bash

# omarchy:summary=Install the hardware-adaptive Proton-Omarchy compatibility layer for Steam
# omarchy:group=install
# omarchy:name=gaming proton

set -euo pipefail

TOOL_DIR="$HOME/.local/share/Steam/compatibilitytools.d/Proton-Omarchy"
CONFIG_DIR="$HOME/.config/omarchy/proton"
GAMES_DIR="$CONFIG_DIR/games"

echo "Installing Proton-Omarchy compatibility layer..."

mkdir -p "$TOOL_DIR" "$GAMES_DIR"
chmod 700 "$CONFIG_DIR" "$GAMES_DIR"

shopt -s nullglob
steam_libs=("$HOME/.local/share/Steam" "$HOME/.steam/root")
for vdf in "$HOME/.local/share/Steam/steamapps/libraryfolders.vdf" "$HOME/.steam/root/steamapps/libraryfolders.vdf"; do
  [[ -f $vdf ]] || continue
  while IFS= read -r lib_path; do
    [[ -n $lib_path ]] && steam_libs+=("$lib_path")
  done < <(awk -F'"' '/"path"[[:space:]]*"/{gsub(/\\\\/, "\\", $4); print $4}' "$vdf" 2>/dev/null || true)
done

installed_proton=""
for candidate_name in "Proton - Experimental" "Proton Hotfix"; do
  for lib in "${steam_libs[@]}"; do
    candidate="$lib/steamapps/common/$candidate_name/proton"
    if [[ -x $candidate ]]; then
      installed_proton="$candidate"
      break 2
    fi
  done
done

if [[ -z $installed_proton ]]; then
  numbered_protons=()
  for lib in "${steam_libs[@]}"; do
    for candidate in "$lib/steamapps/common/Proton "[0-9]*/proton; do
      if [[ -x $candidate ]]; then
        dir_name="${candidate%/proton}"
        dir_name="${dir_name##*/}"
        numbered_protons+=("${dir_name}"$'\t'"${candidate}")
      fi
    done
  done
  if (( ${#numbered_protons[@]} > 0 )); then
    installed_proton=$(printf '%s\n' "${numbered_protons[@]}" | sort -t$'\t' -k1,1Vr | head -n 1 | cut -f2-)
  fi
fi

if [[ -n $installed_proton ]]; then
  upstream_manifest="${installed_proton%/*}/toolmanifest.vdf"
else
  upstream_manifest="${steam_libs[0]}/steamapps/common/Proton - Experimental/toolmanifest.vdf"
fi

cat >"$TOOL_DIR/compatibilitytool.vdf" <<'EOF'
"compatibilitytools"
{
  "compat_tools"
  {
    "Proton-Omarchy"
    {
      "install_path" "."
      "display_name" "Proton-Omarchy (Hardware-Adaptive + BORE + NTSYNC)"
      "from_oslist"  "windows"
      "to_oslist"    "linux"
    }
  }
}
EOF

# Symlink toolmanifest.vdf directly to upstream Proton so require_tool_appid never becomes stale across Proton updates
ln -snf "$upstream_manifest" "$TOOL_DIR/toolmanifest.vdf"

cat >"$TOOL_DIR/proton" <<'EOF'
#!/bin/bash
# Proton-Omarchy Universal Hardware-Adaptive Runtime Wrapper
set -euo pipefail
shopt -s nullglob

# 1. Universal CPU Topology Adaptation via sysfs (L3 cache size + CPPC max frequency)
max_l3=0
min_l3=999999999
max_freq=0
min_freq=999999999
declare -a cpu_ids=()
declare -A cpu_l3=()
declare -A cpu_freq=()

for cpu_dir in /sys/devices/system/cpu/cpu[0-9]*; do
  [[ -d $cpu_dir ]] || continue
  cid="${cpu_dir##*/cpu}"
  [[ $cid =~ ^[0-9]+$ ]] || continue
  cpu_ids+=("$cid")

  l3_raw=$(cat "$cpu_dir/cache/index3/size" 2>/dev/null || echo "0")
  if [[ $l3_raw == *K ]]; then
    l3_kb="${l3_raw%K}"
  elif [[ $l3_raw == *M ]]; then
    l3_num="${l3_raw%M}"
    [[ $l3_num =~ ^[0-9]+$ ]] && l3_kb=$(( l3_num * 1024 )) || l3_kb=0
  else
    l3_kb="$l3_raw"
  fi
  [[ $l3_kb =~ ^[0-9]+$ ]] || l3_kb=0
  cpu_l3[$cid]=$l3_kb
  (( l3_kb > max_l3 )) && max_l3=$l3_kb
  (( l3_kb < min_l3 )) && min_l3=$l3_kb

  khz=$(cat "$cpu_dir/cpufreq/cpuinfo_max_freq" 2>/dev/null || echo "0")
  [[ $khz =~ ^[0-9]+$ ]] || khz=0
  mhz=$(( khz / 1000 ))
  cpu_freq[$cid]=$mhz
  (( mhz > max_freq )) && max_freq=$mhz
  (( mhz > 0 && mhz < min_freq )) && min_freq=$mhz
done

if (( ${#cpu_ids[@]} > 0 )); then
  IFS=$'\n' sorted_ids=($(printf '%s\n' "${cpu_ids[@]}" | sort -n)); unset IFS
else
  sorted_ids=()
fi
p_cores=()
e_cores=()
is_asymmetric_cpu=0

if (( max_l3 >= 65536 && min_l3 > 0 && max_l3 >= min_l3 * 2 )); then
  # AMD Dual-CCD 3D V-Cache (e.g. 7950X3D / 9950X3D): pin to 96MB V-Cache CCD0
  is_asymmetric_cpu=1
  for cid in "${sorted_ids[@]}"; do
    (( cpu_l3[$cid] == max_l3 )) && p_cores+=("$cid")
  done
else
  for cid in "${sorted_ids[@]}"; do
    # Exclude L3-less SoC LP-E island cores on 3-tier hybrid CPUs
    if (( max_l3 > 0 && cpu_l3[$cid] == 0 )); then
      is_asymmetric_cpu=1
      continue
    elif (( cpu_freq[$cid] + 400 >= max_freq )); then
      p_cores+=("$cid")
    else
      is_asymmetric_cpu=1
      e_cores+=("$cid")
    fi
  done
fi

active_cores=("${p_cores[@]}" "${e_cores[@]}")
if (( is_asymmetric_cpu && ${#active_cores[@]} > 0 )); then
  cpu_list=$(IFS=,; echo "${active_cores[*]}")
  export OMAPROTON_TASKSET_CPUS="${OMAPROTON_TASKSET_CPUS:-$cpu_list}"
fi

# 2. Universal GPU & AC/Battery Routing via cached sysfs PCI IDs and omarchy-power-present
on_battery=0
if omarchy-hw-laptop && ! omarchy-power-present; then
  on_battery=1
fi

pci_devices_path="${OMARCHY_PCI_DEVICES_PATH:-/sys/bus/pci/devices}"
gpu_count=0
has_nvidia=0
has_amd=0
has_intel=0
dgpu_vendor=""
dgpu_device=""
best_dgpu_tier=0
best_dgpu_vram=-1
igpu_vendor=""
igpu_device=""
best_igpu_tier=99
best_igpu_vram=-1

for dev in "$pci_devices_path"/*; do
  [[ -f $dev/class && -f $dev/vendor && -f $dev/device ]] || continue
  cls=$(< "$dev/class")
  [[ $cls == 0x03* ]] || continue
  ven=$(< "$dev/vendor")
  did=$(< "$dev/device")
  ven="${ven#0x}"
  did="${did#0x}"
  bdf="${dev##*/}"
  real_dev=$(readlink -f "$dev" 2>/dev/null || echo "$dev")
  label=$(cat "$dev/label" 2>/dev/null || echo "")
  link_width=$(cat "$dev/current_link_width" 2>/dev/null || echo "")
  vram_bytes=$(cat "$dev/mem_info_vram_total" 2>/dev/null || echo "0")
  [[ $vram_bytes =~ ^[0-9]+$ ]] || vram_bytes=0

  gpu_count=$(( gpu_count + 1 ))
  case "$ven" in
    10de) has_nvidia=1 ;;
    1002) has_amd=1 ;;
    8086) has_intel=1 ;;
  esac

  if [[ $ven == "10de" || $cls == 0x0302* ]]; then
    tier=3
  elif [[ ${label,,} == *onboard* || ${label,,} == *integrated* || $bdf == *:00:* || $link_width == "0" || $real_dev == */0000:00:08.*/* ]]; then
    tier=1
  else
    tier=2
  fi

  if (( tier >= 2 )) && (( tier > best_dgpu_tier || (tier == best_dgpu_tier && vram_bytes >= best_dgpu_vram) )); then
    dgpu_vendor="$ven"
    dgpu_device="$did"
    best_dgpu_tier=$tier
    best_dgpu_vram=$vram_bytes
  fi

  if (( tier < best_igpu_tier || (tier == best_igpu_tier && (best_igpu_vram < 0 || vram_bytes < best_igpu_vram)) )); then
    igpu_vendor="$ven"
    igpu_device="$did"
    best_igpu_tier=$tier
    best_igpu_vram=$vram_bytes
  fi
done

if (( has_nvidia )); then
  if (( gpu_count < 2 || on_battery == 0 )); then
    if [[ ${PROTON_HIDE_NVIDIA_GPU:-0} == "0" ]]; then
      export __NV_PRIME_RENDER_OFFLOAD="${__NV_PRIME_RENDER_OFFLOAD:-1}"
      export __VK_LAYER_NV_optimus="${__VK_LAYER_NV_optimus:-NVIDIA_only}"
      export __GLX_VENDOR_LIBRARY_NAME="${__GLX_VENDOR_LIBRARY_NAME:-nvidia}"
      export VK_LOADER_DRIVERS_SELECT="${VK_LOADER_DRIVERS_SELECT:-*nvidia*}"
      export __GL_SHADER_DISK_CACHE="${__GL_SHADER_DISK_CACHE:-1}"
      export __GL_SHADER_DISK_CACHE_SKIP_CLEANUP="${__GL_SHADER_DISK_CACHE_SKIP_CLEANUP:-1}"
    fi
  else
    unset __NV_PRIME_RENDER_OFFLOAD __VK_LAYER_NV_optimus __GLX_VENDOR_LIBRARY_NAME PROTON_FORCE_NVAPI DXVK_ENABLE_NVAPI DXVK_NVAPI_ALLOW_OTHER_DRIVERS
    if (( has_amd )); then
      export VK_LOADER_DRIVERS_SELECT="*radeon*"
      export RADV_PERFTEST="${RADV_PERFTEST:-gpl,nggc}"
    else
      export VK_LOADER_DRIVERS_SELECT="*intel*"
      export ANV_GPL="${ANV_GPL:-true}"
    fi
  fi
elif (( has_amd )); then
  export RADV_PERFTEST="${RADV_PERFTEST:-gpl,nggc}"
  export AMD_VULKAN_ICD="${AMD_VULKAN_ICD:-RADV}"
  if (( gpu_count >= 2 && on_battery == 0 )) && [[ -n $dgpu_vendor && -n $dgpu_device ]]; then
    export DRI_PRIME="${DRI_PRIME:-1}"
    export MESA_VK_DEVICE_SELECT="${MESA_VK_DEVICE_SELECT:-${dgpu_vendor}:${dgpu_device}!}"
  elif (( gpu_count >= 2 && on_battery == 1 )) && [[ -n $igpu_vendor && -n $igpu_device ]]; then
    unset DRI_PRIME
    export MESA_VK_DEVICE_SELECT="${igpu_vendor}:${igpu_device}!"
  else
    unset DRI_PRIME MESA_VK_DEVICE_SELECT
  fi
elif (( has_intel )); then
  export ANV_GPL="${ANV_GPL:-true}"
fi

# 3. Apply optional system-wide and per-game (SteamAppId) overrides from omarchy-agent-proton
global_overrides="$HOME/.config/omarchy/proton/overrides.env"
if [[ -f $global_overrides && ! -L $global_overrides ]]; then
  source "$global_overrides" >/dev/null
fi

app_id="${SteamAppId:-${STEAM_COMPAT_APP_ID:-}}"
if [[ -n $app_id && $app_id =~ ^[0-9]+$ ]]; then
  game_overrides="$HOME/.config/omarchy/proton/games/${app_id}.env"
  if [[ -f $game_overrides && ! -L $game_overrides ]]; then
    source "$game_overrides" >/dev/null
  fi
fi

TASKSET_CMD=()
verb="${1:-}"
if [[ -n ${OMAPROTON_TASKSET_CPUS:-} ]] && [[ $verb == "run" || $verb == "waitforexitandrun" || $verb == "runinprefix" ]]; then
  TASKSET_CMD=(taskset -c "$OMAPROTON_TASKSET_CPUS")
fi

# 4. Resolve upstream Proton starting from the linked toolmanifest.vdf so the runtime and Proton always match
self_manifest="${BASH_SOURCE[0]%/*}/toolmanifest.vdf"
linked_manifest=$(readlink -f "$self_manifest" 2>/dev/null || true)
target_proton=""
if [[ -n $linked_manifest && -x ${linked_manifest%/*}/proton ]]; then
  target_proton="${linked_manifest%/*}/proton"
fi

if [[ -z $target_proton ]]; then
  steam_libs=("$HOME/.local/share/Steam" "$HOME/.steam/root")
  for vdf in "$HOME/.local/share/Steam/steamapps/libraryfolders.vdf" "$HOME/.steam/root/steamapps/libraryfolders.vdf"; do
    [[ -f $vdf ]] || continue
    while IFS= read -r lib_path; do
      [[ -n $lib_path ]] && steam_libs+=("$lib_path")
    done < <(awk -F'"' '/"path"[[:space:]]*"/{gsub(/\\\\/, "\\", $4); print $4}' "$vdf" 2>/dev/null || true)
  done

  for candidate_name in "Proton - Experimental" "Proton Hotfix"; do
    for lib in "${steam_libs[@]}"; do
      candidate="$lib/steamapps/common/$candidate_name/proton"
      if [[ -x $candidate ]]; then
        target_proton="$candidate"
        break 2
      fi
    done
  done

  if [[ -z $target_proton ]]; then
    numbered_protons=()
    for lib in "${steam_libs[@]}"; do
      for candidate in "$lib/steamapps/common/Proton "[0-9]*/proton; do
        if [[ -x $candidate ]]; then
          dir_name="${candidate%/proton}"
          dir_name="${dir_name##*/}"
          numbered_protons+=("${dir_name}"$'\t'"${candidate}")
        fi
      done
    done
    if (( ${#numbered_protons[@]} > 0 )); then
      target_proton=$(printf '%s\n' "${numbered_protons[@]}" | sort -t$'\t' -k1,1Vr | head -n 1 | cut -f2-)
    fi
  fi
fi

if [[ -n $target_proton ]]; then
  exec "${TASKSET_CMD[@]}" "$target_proton" "$@"
else
  echo "[Proton-Omarchy] Error: Install 'Proton - Experimental' in Steam first." >&2
  exit 1
fi
EOF

chmod 755 "$TOOL_DIR/proton"

if [[ -n $installed_proton ]]; then
  echo "Proton-Omarchy installed to $TOOL_DIR (using $installed_proton)."
else
  if pgrep -x steam >/dev/null 2>&1 && omarchy-cmd-present xdg-open; then
    setsid xdg-open "steam://install/1493710" >/dev/null 2>&1 &
  fi
  cat <<EOF
Proton-Omarchy wrapper staged at $TOOL_DIR.

Required step before selecting Proton-Omarchy in Steam:
  1. Open Steam and sign in.
  2. Install "Proton - Experimental" (or "Proton Hotfix") under Library > Tools
     (or run: xdg-open steam://install/1493710).
  3. Restart Steam so Proton-Omarchy appears in Compatibility Tools.
EOF
fi
