#!/bin/bash

# omarchy:summary=Launch Files in the active terminal's current directory

directory="$(omarchy-cmd-terminal-cwd)"

if omarchy-hw-vmware-svga; then
  exec setsid uwsm-app -- env -u GDK_BACKEND GSK_RENDERER=cairo nautilus --new-window "$directory"
else
  exec setsid uwsm-app -- nautilus --new-window "$directory"
fi
