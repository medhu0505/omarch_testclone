#!/bin/bash

# omarchy:summary=Bind a named shortcut to new keys, or register an app's own shortcut
# omarchy:args=<id> <keys>... [--description <text>] [--command <command>] [--release <command>] [--force] [--json] [--none]
# omarchy:examples=omarchy shortcut set omarchy.dictation.hold F9 "SUPER + R" | omarchy shortcut set com.example.app.record "SUPER + ALT + R" --description "Record" --command "example-app record" | omarchy shortcut set com.example.app.talk Super_R --description "Push to talk" --command "example-app start" --release "example-app stop"

# Keys use Hyprland's syntax, as in o.bind: "SUPER + SHIFT + R", F9, code:191,
# mouse:275, or a modifier on its own such as Super_R. Keys another binding
# already uses are refused (exit 2) and listed; --force takes them, removing
# them from the binding or shortcut that had them.

source omarchy-shortcut-functions

usage() {
  echo "Usage: omarchy-shortcut-set <id> <keys>... [--description <text>] [--command <command>] [--release <command>] [--force] [--json]" >&2
  echo "       omarchy-shortcut-set <id> --none" >&2
  exit 1
}

id="${1:-}"
shortcut_valid_id "$id" || usage
shift

declare -a keys=()
declare -A fields=()
force=0
json=0
none=0

while (($#)); do
  case $1 in
    --description | --command | --release | --release-description)
      (($# >= 2)) || usage
      field=${1#--}
      fields[${field//-/_}]=$2
      shift 2
      ;;
    --force) force=1 && shift ;;
    --json) json=1 && shift ;;
    --none) none=1 && shift ;;
    --*) usage ;;
    *) keys+=("$1") && shift ;;
  esac
done

if ((none == (${#keys[@]} > 0))); then
  usage
fi
for value in "${keys[@]}" "${fields[@]}"; do
  shortcut_valid_value "$value" || shortcut_fail "values must be a single line"
done
for value in "${keys[@]}"; do
  [[ -n ${value//[[:space:]+]/} ]] || shortcut_fail "empty keys"
  shortcut_valid_keys "$value" || shortcut_fail "$value is not a key a shortcut can use"
done

mkdir -p "$SHORTCUTS_DIR"
exec 9>"$SHORTCUTS_DIR/.lock"
flock -w 5 9 || shortcut_fail "shortcuts are busy; try again"

snapshot=$(shortcut_snapshot "$id")
# omarchy.* is Omarchy's own namespace, known even before Hyprland bound it.
if [[ $id == omarchy.* ]]; then
  ((${#fields[@]} == 0)) || shortcut_fail "$id is Omarchy's own shortcut; only its keys can change"
else
  for field in description command release release_description; do
    [[ -v fields[$field] ]] || fields[$field]=$(shortcut_field "$id" "$field")
  done
  [[ -n ${fields[command]} ]] || shortcut_fail "$id is a new shortcut; give it a --command to run"
  [[ -n ${fields[description]} ]] || fields[description]=$id
fi

# The same keys twice would be the same binding.
declare -A chosen=()
declare -a unique=()
for value in "${keys[@]}"; do
  chord=$(shortcut_chord "$value")
  if [[ ! -v chosen[$chord] ]]; then
    chosen[$chord]=$value
    unique+=("$value")
  fi
done
keys=("${unique[@]}")

# What else holds the chosen keys: other named shortcuts, by their keys here or
# in the snapshot, and every live Hyprland binding not belonging to this id.
declare -A owned=()
while read -r value; do
  [[ -n $value ]] && owned[$(shortcut_chord "$value")]=1
done < <(jq -r '.bound[]?' <<<"$snapshot")

declare -a conflicts=()
declare -A taken_from=()
declare -A seen=()
while read -r other; do
  [[ $other == "$id" ]] && continue
  while read -r value; do
    [[ -n $value ]] || continue
    chord=$(shortcut_chord "$value")
    if [[ -v chosen[$chord] ]]; then
      conflicts+=("${chosen[$chord]}"$'\t'"$(omarchy-shortcut-get "$other" --json | jq -r '.description // ""')"$'\t'"$other")
      taken_from[$other]=1
      seen[$chord]=1
    fi
  done < <(shortcut_keys "$other")
done < <(shortcut_ids)

if shortcut_hyprland_running; then
  while IFS=$'\t' read -r chord description; do
    if [[ -v chosen[$chord] && ! -v owned[$chord] && ! -v seen[$chord] ]]; then
      conflicts+=("${chosen[$chord]}"$'\t'"$description"$'\t')
      seen[$chord]=1
    fi
  done < <(shortcut_live_bindings)
fi

if ((${#conflicts[@]})) && ((!force)); then
  if ((json)); then
    printf '%s\n' "${conflicts[@]}" | jq -Rn '{ conflicts: [inputs | split("\t") | { keys: .[0], description: .[1], id: (if .[2] == "" then null else .[2] end) }] }'
  else
    for conflict in "${conflicts[@]}"; do
      IFS=$'\t' read -r value description other <<<"$conflict"
      echo "$value is already used by \"${description:-a binding}\"${other:+ ($other)}" >&2
    done
    echo "Choose other keys, or pass --force to take them." >&2
  fi
  exit 2
fi

# Write a shortcut's file whole, then move it into place, so Hyprland never
# reads half of one.
write_shortcut() {
  local target="$SHORTCUTS_DIR/$1" temporary
  shift

  temporary=$(mktemp "$SHORTCUTS_DIR/.$(basename "$target").XXXXXX")
  printf '%s\n' "$@" >"$temporary"
  mv -f "$temporary" "$target"
}

# Taking keys from another named shortcut leaves it with the rest of its own.
for other in "${!taken_from[@]}"; do
  mapfile -t remaining < <(grep -v '^keys=' "$SHORTCUTS_DIR/$other" 2>/dev/null)
  kept=0
  while read -r value; do
    if [[ -n $value && ! -v chosen[$(shortcut_chord "$value")] ]]; then
      remaining+=("keys=$value")
      kept=1
    fi
  done < <(shortcut_keys "$other")
  ((kept)) || remaining+=("keys=")
  write_shortcut "$other" "${remaining[@]}"
done

declare -a lines=()
for field in description release_description command release; do
  [[ -n ${fields[$field]:-} ]] && lines+=("$field=${fields[$field]}")
done
if ((none)); then
  lines+=("keys=")
else
  for value in "${keys[@]}"; do
    lines+=("keys=$value")
  done
fi
write_shortcut "$id" "${lines[@]}"

shortcut_apply "$id" "${!taken_from[@]}"
