#!/bin/bash

# omarchy:summary=Reinstall all default Omarchy packages from the stable channel, or on aarch64 the edge channel
# omarchy:requires-sudo=true

set -e

# Reinstall all default Omarchy packages from the platform's default channel
# (stable, or edge on aarch64) and downgrade any packages that are too new.

# Set the package repository to the platform's default channel
source "$OMARCHY_PATH/install/helpers/pacman.sh"
platform=$(omarchy-hw-platform)
channel=$(omarchy_pacman_default_channel "$platform")
omarchy-refresh-pacman "$channel"

# Downgrade any packages to that channel's setup
omarchy-update-pacman -Suu --noconfirm

# Ensure this platform's default packages are installed
default_packages=$(omarchy-pkg-defaults)
mapfile -t packages <<<"$default_packages"

# Leave out a default that another installed package provides in its place, such
# as a drop-in replacement. --needed only skips a package installed under its own
# name, so pacman would try to swap the replacement out, and --noconfirm declines
# that conflict, which fails the whole install.
installed_names=$(pacman -Qq)
declare -A installed unsatisfied
while IFS= read -r name; do [[ -z $name ]] || installed[$name]=1; done <<<"$installed_names"
absent=()
for package in "${packages[@]}"; do
  [[ -n ${installed[$package]:-} ]] || absent+=("$package")
done
if (( ${#absent[@]} > 0 )); then
  while IFS= read -r name; do unsatisfied[$name]=1; done < <(pacman -T -- "${absent[@]}")
fi
wanted=()
for package in "${packages[@]}"; do
  if [[ -n ${installed[$package]:-} || -n ${unsatisfied[$package]:-} ]]; then
    wanted+=("$package")
  fi
done

omarchy-update-pacman -Syu --noconfirm --needed "${wanted[@]}"
