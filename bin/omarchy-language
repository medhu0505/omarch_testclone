#!/bin/bash

# omarchy:summary=Show or set the Omarchy language and the session's locale
# omarchy:args=[<code>|list|locale [<code>]]
# omarchy:examples=omarchy language | omarchy language da | omarchy language list

set -euo pipefail

locales_json=${OMARCHY_LOCALES_JSON:-$OMARCHY_PATH/default/i18n/locales.json}
language_file=${OMARCHY_LANGUAGE_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/language}

# Root always writes the real file; the override is for unprivileged tests
# (same convention as install/config/locale.sh).
locale_gen=/etc/locale.gen
if (( EUID != 0 )); then
  locale_gen=${OMARCHY_LOCALE_GEN:-$locale_gen}
fi

known_language() {
  jq -e --arg code "$1" 'has($code)' "$locales_json" >/dev/null 2>&1
}

current_language() {
  local code=""
  if [[ -f $language_file ]]; then
    code=$(head -n 1 "$language_file" | tr -d '[:space:]')
  fi

  if [[ -n $code ]] && known_language "$code"; then
    echo "$code"
  else
    echo "en"
  fi
}

locale_for() {
  jq -r --arg code "$1" '.[$code].locale // empty' "$locales_json"
}

name_for() {
  jq -r --arg code "$1" '.[$code].name // empty' "$locales_json"
}

list_languages() {
  # One tab-delimited row per language: native name, code, English name.
  # English first, the rest sorted by English name so the picker is findable
  # in any language.
  jq -r '
    to_entries
    | map({code: .key, name: .value.name, englishName: .value.englishName})
    | sort_by(if .code == "en" then "" else .englishName end)
    | .[]
    | [.name, .code, .englishName] | @tsv
  ' "$locales_json"
}

locale_generated() {
  # locale -a normalizes punctuation away (en_US.utf8), so compare squashed.
  local want available
  want=$(echo "$1" | tr -cd 'a-zA-Z0-9' | tr '[:upper:]' '[:lower:]')
  available=" $(locale -a 2>/dev/null | tr -cd 'a-zA-Z0-9\n' | tr '[:upper:]' '[:lower:]' | tr '\n' ' ') "
  [[ $available == *" $want "* ]]
}

# The session's LANG lives with the user, beside the language choice:
# uwsm sources this at login and exports it to every app it launches.
session_env=${XDG_CONFIG_HOME:-$HOME/.config}/uwsm/env.d/50-omarchy-language

# Generating a locale is the one step that needs root, run as one elevated
# bash so it asks for a password once. It reads only its arguments: the
# locale (from the registry) and locale.gen.
read -r -d '' GENERATE_LOCALE_SCRIPT <<'SH' || true
set -euo pipefail
locale=$1 locale_gen=$2
# locale.gen spells some entries without the codeset (hi_IN UTF-8).
base=${locale%.UTF-8}
if grep -qE "^#$base(\.UTF-8)? UTF-8" "$locale_gen" 2>/dev/null; then
  sed -i -E "s/^#($base(\.UTF-8)? UTF-8)/\1/" "$locale_gen"
elif ! grep -qE "^$base(\.UTF-8)? UTF-8" "$locale_gen" 2>/dev/null; then
  echo "$locale UTF-8" >>"$locale_gen"
fi
locale-gen "$locale" >/dev/null
SH

generate_locale() {
  local locale=$1
  locale_generated "$locale" && return

  # sudo where a terminal can carry its prompt; picked from the menu there is
  # none, so polkit puts the prompt on screen instead.
  local -a priv
  if (( EUID == 0 )); then
    priv=()
  elif [[ -t 0 ]]; then
    priv=(sudo)
  else
    priv=(pkexec)
  fi

  "${priv[@]}" /bin/bash -c "$GENERATE_LOCALE_SCRIPT" omarchy-language "$locale" "$locale_gen"
}

# Sets LANG for the next login, and for the apps opened from now on: they
# start from the systemd user environment, which takes the new value at once.
# Apps already running keep the language they started with.
apply_session_locale() {
  local locale=$1
  mkdir -p "$(dirname "$session_env")"
  printf '# The session language, set by omarchy-language (Setup > Language).\nexport LANG=%s\n' "$locale" >"$session_env"
  dbus-update-activation-environment --systemd "LANG=$locale" >/dev/null 2>&1 || true
}

set_language() {
  local code=$1
  if ! known_language "$code"; then
    echo "Usage: omarchy-language [<code>|list|locale [<code>]]" >&2
    echo "Unknown language code: $code" >&2
    echo "Run 'omarchy-language list' to see the available codes." >&2
    exit 1
  fi

  local locale name
  locale=$(locale_for "$code")
  name=$(name_for "$code")

  generate_locale "$locale"
  apply_session_locale "$locale"

  # The choice is only persisted once the locale exists, so a cancelled
  # password prompt cannot leave the interface switched with LANG behind it.
  mkdir -p "$(dirname "$language_file")"
  echo "$code" >"$language_file"

  omarchy-notification-send -g  "$(omarchy-i18n language.changed "$name")" "$(omarchy-i18n language.newApps)"
}

case "${1:-}" in
"")
  current_language
  ;;
list)
  list_languages
  ;;
locale)
  code=${2:-$(current_language)}
  if ! known_language "$code"; then
    echo "Unknown language code: $code" >&2
    exit 1
  fi
  locale_for "$code"
  ;;
*)
  set_language "$1"
  ;;
esac
