#!/bin/bash

# omarchy:summary=Launch a URL as a web app in the default supported browser
# omarchy:args=<url>

browser=$(omarchy-cmd-default-browser)

case $browser in
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*) browser="chromium.desktop" ;;
esac

desktop_exec=$(sed -s -n '/^\[Desktop Entry\]/,/^\[/s/^Exec=//p' {~/.local,~/.nix-profile,/usr}/share/applications/$browser 2>/dev/null | head -1)

# Every word of the Exec line, so a wrapper like `env VAR=1 brave` keeps the
# arguments that make it the browser.
mapfile -d '' -t browser_command < <(xargs -r printf '%s\0' <<<"$desktop_exec" 2>/dev/null)
browser_exec=${browser_command[0]:-}

# The arguments go where the entry's %u or %U is, or last; other field codes are dropped.
arguments=(--app="$1" "${@:2}")
launch_command=("$browser_exec")
entry_arguments=false
for word in "${browser_command[@]:1}"; do
  case $word in
  %[uUfF]) launch_command+=("${arguments[@]}") arguments=() ;;
  %[a-zA-Z]) ;;
  *) launch_command+=("${word//'%%'/%}") entry_arguments=true ;;
  esac
done
launch_command+=("${arguments[@]}")

# The running browser would never see the entry's own arguments, so only a bare
# entry is handed to it.
if $entry_arguments || ! omarchy-cmd-browser-handoff "$browser_exec" --app="$1" "${@:2}"; then
  exec setsid uwsm-app -- "${launch_command[@]}"
fi
