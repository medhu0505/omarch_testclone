#!/bin/bash

# omarchy:summary=Leave out the preinstalled apps a region cannot reach, for this user
# omarchy:args=<region>
# omarchy:hidden=true

set -euo pipefail

region=${1:-}
if [[ ! $region =~ ^[a-z]{2}$ ]]; then
  echo "Usage: omarchy-region-preinstalls <region>" >&2
  exit 1
fi

skip_list="$OMARCHY_PATH/default/regions/$region/apps-skip"
[[ -r $skip_list ]] || exit 0

# The record outlives the install: launcher refreshes and the key bindings read
# it, so a later region switch never brings these back or takes others away.
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
mkdir -p "$state_dir"
sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^#/d' -e '/^$/d' -e '/\//d' "$skip_list" >"$state_dir/preinstalls-skipped"

pinned=$(omarchy-dock pinned 2>/dev/null || true)
while IFS= read -r name; do
  rm -f "$HOME/.local/share/applications/$name.desktop"
  if grep -qxF -- "$name" <<<"$pinned"; then
    omarchy-dock unpin "$name" >/dev/null
  fi
done <"$state_dir/preinstalls-skipped"

if [[ -d $HOME/.local/share/applications ]]; then
  update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
fi
